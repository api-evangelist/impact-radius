    {
      "id": "09dc6e8d-5d66-4701-a454-95e236330ddf",
      "name": "ClickExport",
      "description": {
        "content": "Asynchronously export click event data as CSV, JSON, or XML.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "9577cbd8-fa7c-4000-9b8b-405aa4f5deef",
          "name": "Export Clicks",
          "request": {
            "name": "Export Clicks",
            "description": {
              "content": "Schedules a background job to asynchronously export clicks. Returns immediately with a `QueuedUri` pointing to the Partner Jobs API — poll that endpoint to track progress, then download the result from `ResultUri` once the job is complete.\n\n**Migration note:** If you're migrating from the `Clicks` endpoint to `ClickExport`, note that the result object uses `ProgramId` and `ProgramName` in place of the previous `CampaignId` and `CampaignName`.\n\nSee the impact.com rate-limit documentation for this endpoint's request limits.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Mediapartners",
                ":AccountSID",
                "ClickExport"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ProgramId",
                  "value": "<string>",
                  "description": "Filter to clicks for a specific Program (formerly known as Campaign). Repeat the parameter to include multiple Programs."
                },
                {
                  "disabled": false,
                  "key": "ProgramId",
                  "value": "<string>",
                  "description": "Filter to clicks for a specific Program (formerly known as Campaign). Repeat the parameter to include multiple Programs."
                },
                {
                  "disabled": false,
                  "key": "AdId",
                  "value": "<string>",
                  "description": "Filter to clicks on a specific ad. Repeat the parameter to include multiple ads."
                },
                {
                  "disabled": false,
                  "key": "AdId",
                  "value": "<string>",
                  "description": "Filter to clicks on a specific ad. Repeat the parameter to include multiple ads."
                },
                {
                  "disabled": false,
                  "key": "Date",
                  "value": "<date>",
                  "description": "Click date to export in `yyyy-MM-dd` format. Defaults to today if omitted."
                },
                {
                  "disabled": false,
                  "key": "SubId",
                  "value": "<string>",
                  "description": "Filter to clicks that include the specified Sub ID value. Repeat the parameter to include multiple Sub IDs."
                },
                {
                  "disabled": false,
                  "key": "SubId",
                  "value": "<string>",
                  "description": "Filter to clicks that include the specified Sub ID value. Repeat the parameter to include multiple Sub IDs."
                },
                {
                  "disabled": false,
                  "key": "UniqueClick",
                  "value": "<string>",
                  "description": "Set to `TRUE` to return only clicks that meet the IAB standards for a unique click. See the IAB Click Measurement Guidelines for details."
                },
                {
                  "disabled": false,
                  "key": "ResultFormat",
                  "value": "CSV",
                  "description": "Format for the exported result file."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "AccountSID",
                  "description": "(Required) Unique identifier for the partner account."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
