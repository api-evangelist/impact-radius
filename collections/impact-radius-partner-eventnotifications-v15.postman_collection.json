                  "raw": "{\n  \"campaign_id\": \"10306\",\n  \"action_id\": \"1234567890\",\n  \"status\": \"APPROVED\",\n  \"payout\": \"5.00\",\n  \"items\": [\n    {\n      \"sku\": \"APP-0016\",\n      \"qty\": \"1\",\n      \"amt\": \"719.10\"\n    },\n    {\n      \"sku\": \"APP-0016\",\n      \"qty\": \"1\",\n      \"amt\": \"719.10\"\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
