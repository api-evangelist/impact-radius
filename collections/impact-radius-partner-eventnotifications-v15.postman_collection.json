            "name": "Receive an event notification (GET)",
            "description": {
              "content": "impact.com sends a GET request to your configured URL with event data as query-string parameters. This delivery mode is typically used for simple pixel-style integrations.\n\nThe query parameters present depend on the URL template you configure in your impact.com Event Notifications settings.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "your-configured-path"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
