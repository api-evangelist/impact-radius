                  "disabled": false,
                  "key": "Name",
                  "value": "<string>",
                  "description": "Filter by a URL-encoded string matching `FirstName`, `LastName`, or `Username`."
                },
                {
                  "disabled": false,
                  "key": "State",
                  "value": "<string>",
                  "description": "Filter the list of users by their account state."
