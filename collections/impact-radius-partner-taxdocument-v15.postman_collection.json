  "info": {
    "_postman_id": "a6123e15-11b8-4aa3-a2bd-0773dc63cbef",
    "name": "Partner Tax Documents API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Tax Documents capture the IRS tax form (W9, W8BEN, W8BENE) that impact.com requires from partners\nbefore payouts can be issued. Documents are collected through a hosted signing flow provided by\nDocuSign or Comply Exchange.\n\nTypical workflow:\n\n1. **Create a tax document** (POST `/TaxDocument`) — returns an iframe URL that the partner opens to fill in and sign the form.\n2. **Complete** (POST `/TaxDocument/Complete`) — called after the user finalizes submission in the Comply Exchange iframe so the system records the outcome. DocuSign uses the `ReturnUrl` callback instead.\n3. **Retrieve** the latest document (GET `/TaxDocument`), a specific document by Id (GET `/TaxDocument/{Id}`), or the full list (GET `/TaxDocuments`) to track status.\n\n\nContact Support:\n Name: impact.com Developer Support",
      "type": "text/plain"
    }
  }
}