                  "key": "id",
                  "value": "<string>",
                  "description": "(Required) The Id of the tax document being submitted."
                },
                {
                  "disabled": false,
                  "key": "event",
                  "value": "<string>",
                  "description": "(Required) The lifecycle event being signalled. Always `Complete`."
                }
              ]
