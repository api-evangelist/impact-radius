                  "value": "<string>",
                  "description": "Customer's IP address."
                },
                {
                  "disabled": false,
                  "key": "AppName",
                  "value": "<string>",
                  "description": "Name of the mobile app. Only for mobile events."
                },
                {
                  "disabled": false,
                  "key": "AppPackage",
                  "value": "<string>",
                  "description": "Package name for the mobile app the user installed. Only for mobile events."
                },
                {
                  "disabled": false,
                  "key": "AppVer",
                  "value": "<string>",
                  "description": "Version of the mobile app. Only for mobile events."
                },
                {
                  "disabled": false,
                  "key": "DeviceMfr",
                  "value": "<string>",
