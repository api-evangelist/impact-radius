          "name": "List Actions",
          "request": {
            "name": "List Actions",
            "description": {
              "content": "Returns a list of actions attributed to you, ordered by creation date (newest first).\n\n**Date filtering rules:**\n- If no `StartDate` and `EndDate` are specified, only records from the past 7 days are returned.\n- `StartDate` and `EndDate` cannot be more than 45 days apart.\n- `StartDate` cannot exceed 3 years in the past.\n- If `StartDate` is specified, `EndDate` must also be specified.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Mediapartners",
                ":AccountSID",
                "Actions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "CampaignId",
                  "value": "<integer>",
                  "description": "Filters actions for a specific campaign."
                },
                {
                  "disabled": false,
                  "key": "State",
                  "value": "<string>",
                  "description": "Filters actions by their current state."
                },
                {
                  "disabled": false,
                  "key": "ActionDateStart",
                  "value": "<dateTime>",
                  "description": "Filters actions with an EventDate on or after this value."
                },
                {
                  "disabled": false,
                  "key": "ActionDateEnd",
                  "value": "<dateTime>",
                  "description": "Filters actions with an EventDate on or before this value."
                },
                {
                  "disabled": false,
                  "key": "StartDate",
                  "value": "<dateTime>",
                  "description": "Filters actions last updated on or after this value. Requires EndDate. Cannot be more than 45 days before EndDate or more than 3 years in the past."
                },
                {
                  "disabled": false,
                  "key": "EndDate",
                  "value": "<dateTime>",
                  "description": "Filters actions last updated on or before this value. Requires StartDate."
                },
                {
                  "disabled": false,
                  "key": "LockingDateStart",
                  "value": "<dateTime>",
                  "description": "Filters actions with a LockingDate on or after this value. Requires LockingDateEnd. The range between LockingDateStart and LockingDateEnd cannot exceed 45 days."
