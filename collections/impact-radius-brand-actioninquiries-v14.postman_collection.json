                  "description": "(Required) The ID of the campaign (program) to view action inquiries for."
                },
                {
                  "disabled": false,
                  "key": "StartDate",
                  "value": "<dateTime>",
                  "description": "Filters for inquiries created on or after this date (ISO 8601)."
                },
                {
                  "disabled": false,
                  "key": "EndDate",
                  "value": "<dateTime>",
                  "description": "Filters for inquiries created on or before this date (ISO 8601)."
                },
                {
                  "disabled": false,
