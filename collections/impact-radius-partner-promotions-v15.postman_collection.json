              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "AccountSID",
                  "description": "(Required) Unique identifier for the partner account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "Id",
                  "description": "(Required) The unique identifier of the promotion (matches `PromotionIds` from a List Promotions response)."
