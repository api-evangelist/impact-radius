  "info": {
    "_postman_id": "0ebe21f6-de0d-47bb-9f7d-d2f37020d43c",
    "name": "Partner Promotions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Use the Promotions API to discover limited-time offers from the brands you partner with —\nsales, coupon codes, seasonal campaigns — and surface them to your audience.\n\nEach promotion includes a headline, an active date range, an optional redemption code, and a\ndirect link to the products it covers in the Catalogs API. Use this endpoint to power deal\npages, coupon directories, browser extensions, and newsletter content.\n\n\nContact Support:\n Name: impact.com Developer Support",
      "type": "text/plain"
    }
  }
