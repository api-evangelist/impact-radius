        {
          "id": "fdc2d331-5629-49c6-af52-3f9e57734401",
          "name": "Replay a job",
          "request": {
            "name": "Replay a job",
            "description": {
              "content": "Re-runs a previously executed job with the same parameters. Useful for jobs in a terminal state (`COMPLETED`, `CANCELLED`, `ERROR`, or `FAILED`) when fresh data is wanted over the same export window.\n\nThe `Job.Replayable` field on the original job indicates whether the job can be replayed. Replaying creates a new job with a new `Id` — the original job is not modified.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Agencies",
                ":AccountSID",
                "Jobs",
                ":JobId",
                "Replay"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "AccountSID",
                  "description": "(Required) Your Agency Account SID."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "JobId",
                  "description": "(Required) The unique job identifier (UUID). Returned in the `QueuedUri` of any endpoint that schedules a job (for example `GET /ReportExport/{ReportId}`)."
                }
              ]
            },
            "header": [
