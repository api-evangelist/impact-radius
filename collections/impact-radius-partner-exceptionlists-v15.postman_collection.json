  "info": {
    "_postman_id": "1873b8cd-50a3-4082-b028-a5cfcaca7778",
    "name": "Partner Exception Lists API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "An exception list allows a brand to pay different commission rates based on the product category or SKU associated with a tracked action. Exception lists are linked to contracts — retrieve the ExceptionListId from the Contracts API, then use these endpoints to retrieve the list details and its items.\n\n\nContact Support:\n Name: impact.com Developer Support",
      "type": "text/plain"
    }
