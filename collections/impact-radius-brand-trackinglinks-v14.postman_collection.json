          "name": "Generate a Tracking Link",
          "request": {
            "name": "Generate a Tracking Link",
            "description": {
              "content": "Creates a new tracking link for a specified media partner within a program.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Advertisers",
                ":AccountSID",
                "Programs",
                ":ProgramId",
                "TrackingLinks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "MediaPartnerId",
                  "value": "<integer>",
                  "description": "(Required) The unique identifier for the media partner."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "AccountSID",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "ProgramId",
                  "description": "(Required) The unique identifier for the program."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "Type",
                  "value": "Regular",
                  "description": "The type of tracking link to create. 'Vanity' allows for a `CustomPath`."
                },
                {
                  "disabled": false,
                  "key": "CustomPath",
                  "value": "<string>",
                  "description": "A custom path for a 'Vanity' link (e.g., 'MyCustomLink')."
                },
                {
                  "disabled": false,
                  "key": "AdId",
                  "value": "<integer>",
                  "description": "The unique ID of the ad to associate with the link. If omitted, redirects to the program's default landing page."
                },
                {
                  "disabled": false,
                  "key": "DeepLink",
                  "value": "<uri>",
                  "description": "A specific URL to redirect the user to, overriding the default."
                },
                {
                  "disabled": false,
                  "key": "MediaPartnerPropertyId",
                  "value": "<integer>",
                  "description": "The unique ID of the partner's media property where the link will be used."
                }
              ]
            }
          },
