                  "disabled": false,
                  "key": "AdId",
                  "value": "<integer>",
                  "description": "ID of the ad that was clicked. Can be repeated for multiple ads."
                },
                {
                  "disabled": false,
                  "key": "Date",
                  "value": "<date>",
                  "description": "The date for the clicks to be exported, in 'yyyy-MM-dd' format. Defaults to today. Only dates after April 9, 2024 are supported."
                },
                {
                  "disabled": false,
                  "key": "MediaId",
                  "value": "<integer>",
                  "description": "The unique ID of the partner. Can be repeated for multiple partners."
                },
                {
                  "disabled": false,
