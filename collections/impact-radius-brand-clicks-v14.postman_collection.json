          "name": "Export Clicks Asynchronously",
          "request": {
            "name": "Export Clicks Asynchronously",
            "description": {
              "content": "Schedules a job to export daily clicks. It returns a URI to poll for job status updates and a URI to download the exported file once the job is complete.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Advertisers",
                ":AccountSID",
                "Programs",
                ":ProgramId",
                "ClickExport"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "AdId",
                  "value": "<integer>",
