{
  "item": [
    {
      "id": "bced3e1f-44ac-4553-bac2-2c42468aa5a2",
      "name": "Compliance Content",
      "description": {
        "content": "Submit content for impact.com compliance monitoring and retrieve job status and results.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d5a98d06-c216-4329-bedb-966a560b0897",
          "name": "Create compliance content submission",
          "request": {
            "name": "Create compliance content submission",
            "description": {
              "content": "Submits one or more content items for compliance monitoring. Content is processed asynchronously — the response returns immediately with a `QueuedUri` pointing to the job's status endpoint.\n\nUse the returned URI (or extract the submission `Id` from its tail) to poll the job with the **Get compliance submission status** endpoint. Once the status is `COMPLETED`, retrieve the per-item results from the **Get compliance submission results** endpoint.\n\nAccepts either `application/json` (recommended; supports batch submissions via the `Contents` array) or `application/x-www-form-urlencoded` (single item only).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Agencies",
                ":AccountSID",
                "Compliance",
                "Content"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "AccountSID",
                  "description": "(Required) Your Agency Account SID."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "AdvertiserId",
                  "value": "<integer>",
                  "description": "(Required) The unique numeric identifier of the advertiser account that owns the program this content is associated with."
                },
                {
                  "disabled": false,
                  "key": "CampaignId",
                  "value": "<integer>",
                  "description": "(Required) The unique numeric identifier of the program (campaign) this content is part of."
                },
                {
                  "disabled": false,
                  "key": "Url",
                  "value": "<uri>",
                  "description": "(Required) The full URL of the content page being submitted for review."
                },
                {
                  "disabled": false,
                  "key": "Type",
                  "value": "<string>",
                  "description": "(Required) The type of compliance content being submitted. Only `PAGE` is currently supported."
                },
                {
                  "disabled": false,
                  "key": "Reason",
                  "value": "<string>",
                  "description": "(Required) A free-text description of why this content is being submitted for compliance review. Useful for audit trails."
                },
                {
                  "disabled": false,
                  "key": "Source",
                  "value": "<string>",
                  "description": "(Required) The source system submitting the content. Only `CONTENT_API` is currently supported."
                },
                {
                  "disabled": false,
                  "key": "PartnerId",
                  "value": "<integer>",
                  "description": "The numeric ID of the partner publishing the content. **Required** if the program has \"Partner ID Required\" enabled in its compliance settings."
                },
                {
                  "disabled": false,
                  "key": "ContentLabels",
                  "value": "<string>",
                  "description": "A comma-separated list of labels for categorizing the content (e.g., `\"product-review,paid\"`). Free-form values defined by the agency."
                },
                {
                  "disabled": false,
                  "key": "Products",
                  "value": "<string>",
                  "description": "A comma-separated list of product SKUs that this content refers to."
                },
                {
                  "disabled": false,
                  "key": "Keywords",
                  "value": "{\"Name\":\"<string>\",\"Status\":\"<string>\",\"Function\":\"<string>\"}",
                  "description": "Keywords associated with the content. Each keyword has its own approval status and monitoring function — useful for tracking compliance against specific terms."
                },
                {
                  "disabled": false,
                  "key": "Keywords",
                  "value": "{\"Name\":\"<string>\",\"Status\":\"<string>\",\"Function\":\"<string>\"}",
                  "description": "Keywords associated with the content. Each keyword has its own approval status and monitoring function — useful for tracking compliance against specific terms."
                },
                {
                  "disabled": false,
                  "key": "Language",
                  "value": "<string>",
                  "description": "The language of the content as an ISO 639-1 two-letter code (e.g., `en`, `fr`, `es`)."
                },
                {
                  "disabled": false,
                  "key": "PaidLink",
                  "value": "<boolean>",
                  "description": "Whether this content is a paid (sponsored) link. Defaults to `false`."
                },
                {
                  "disabled": false,
                  "key": "Monitored",
                  "value": "<boolean>",
                  "description": "Whether to enroll this content in impact.com's ongoing Compliance Monitoring service. Defaults to `false`."
                },
                {
                  "disabled": false,
                  "key": "Cadence",
                  "value": "<boolean>",
                  "description": "Whether to apply cadence rules (re-checking on a schedule) to this content within Compliance Monitoring. Only effective when `Monitored` is `true`."
                }
              ]
            }
          },
