  "info": {
    "_postman_id": "60447a09-f706-47da-a5d9-40ad78fb13ee",
    "name": "Partner Promo Code Exception Lists API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "A promo code exception list allows a brand to pay different commission rates based on the promo code associated with a tracked action. Promo code exception lists are linked to contracts — retrieve the PromoCodeExceptionListId from the Contracts API, then use these endpoints to retrieve the list details and its items.\n\n\nContact Support:\n Name: impact.com Developer Support",
      "type": "text/plain"
    }
