                  "disabled": false,
                  "key": "StartDate",
                  "value": "<dateTime>",
                  "description": "Start date for the report data as an ISO 8601 date-time (YYYY-MM-DDThh:mm:ssZ), e.g. 2026-01-15T00:00:00Z. Required for most reports."
