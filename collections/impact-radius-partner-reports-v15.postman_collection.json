          "name": "Export a report (asynchronous)",
          "request": {
            "name": "Export a report (asynchronous)",
            "description": {
              "content": "Schedules a background job to export a report. Returns immediately with a `QueuedUri` pointing to the Partner Jobs API — poll that endpoint to track progress, then download the result from `ResultUri` once the job is complete.\n\nUse this endpoint instead of Run Report for any dataset that may exceed 20,000 rows.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Mediapartners",
                ":AccountSID",
                "ReportExport",
                ":Id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "SUBAID",
                  "value": "<string>",
                  "description": "Program ID to scope the report to a single brand. Omit to include all programs you partner with."
                },
                {
                  "disabled": false,
                  "key": "START_DATE",
                  "value": "<date>",
                  "description": "(Required) Start date for the report's date range, in `YYYY-MM-DD` format."
                },
                {
                  "disabled": false,
                  "key": "END_DATE",
                  "value": "<date>",
                  "description": "(Required) End date for the report's date range, in `YYYY-MM-DD` format."
                },
                {
                  "disabled": false,
                  "key": "ResultFormat",
                  "value": "CSV",
                  "description": "Format for the exported result file."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "AccountSID",
                  "description": "(Required) Unique identifier for the partner account."
