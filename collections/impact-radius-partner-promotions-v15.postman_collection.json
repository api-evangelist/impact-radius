            "name": "Retrieve a promotion",
            "description": {
              "content": "Retrieves the details of a single promotion. Pass the value of `PromotionIds` (from a List Promotions response) as the path `Id`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Mediapartners",
                ":AccountSID",
                "Promotions",
                ":Id"
