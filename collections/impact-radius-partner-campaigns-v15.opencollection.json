{
  "opencollection": "1.0.0",
  "info": {
    "name": "Partner Programs API",
    "version": "15"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Programs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all joined programs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.impact.com/Mediapartners/:AccountSID/Campaigns",
            "params": [
              {
                "name": "AccountSID",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the partner account."
              },
              {
                "name": "InsertionOrderStatus",
                "value": "",
                "type": "query",
                "description": "Filter the result to programs whose contract has the specified status."
              }
            ]
          },
          "docs": "Returns the list of programs you have signed up for."
        },
        {
          "info": {
            "name": "Retrieve a program",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.impact.com/Mediapartners/:AccountSID/Campaigns/:CampaignId",
            "params": [
              {
                "name": "AccountSID",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the partner account."
              },
              {
                "name": "CampaignId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the program."
              }
            ]
          },
          "docs": "Returns the details of a single program you've joined."
        },
        {
          "info": {
            "name": "Retrieve program logo",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.impact.com/Mediapartners/:AccountSID/Campaigns/:CampaignId/Logo",
            "params": [
              {
                "name": "AccountSID",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the partner account."
              },
              {
                "name": "CampaignId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the program."
              }
            ]
          },
          "docs": "Returns the program's logo as a binary image. Use the `Accept` request header to choose the format — `image/gif` (default), `image/png`, or `image/jpeg`.\n"
        }
      ]
    }
  ],
  "bundled": true
}