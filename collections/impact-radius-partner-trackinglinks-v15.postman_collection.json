    {
      "id": "5177af3d-a73b-4d46-9986-40aa35da4f27",
      "name": "Tracking Links",
      "description": {
        "content": "Endpoint for generating partner tracking links for a brand's program.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f99e2537-7ca2-47bb-a7f5-1ed892fa7baa",
          "name": "Create a tracking link",
          "request": {
            "name": "Create a tracking link",
            "description": {
              "content": "Generates a new tracking link for the specified program. Up to **5,000 vanity links** can exist on an account — exceeding that limit returns a 403 Forbidden response.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Mediapartners",
                ":AccountSID",
                "Programs",
                ":ProgramId",
                "TrackingLinks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "Type",
                  "value": "Regular",
                  "description": "The type of tracking link to generate.\n\n- `Regular`: System-generated short link.\n- `Vanity`: Branded link with a custom path (requires `CustomPath`).\n"
                },
                {
                  "disabled": false,
                  "key": "CustomPath",
                  "value": "<string>",
                  "description": "Custom path that follows the tracking domain (e.g., `SummerSale` produces `https://example.sjv.io/SummerSale`). Required when `Type=Vanity`. If omitted on a vanity link, a random path is generated."
                },
                {
                  "disabled": false,
                  "key": "AdId",
                  "value": "<string>",
                  "description": "Unique identifier of an ad to deep-link into (see the Partner Ads API). If omitted, the tracking link redirects to the brand's default landing page."
                },
                {
                  "disabled": false,
                  "key": "DeepLink",
                  "value": "<uri>",
                  "description": "The exact destination URL the tracking link should redirect to after attribution. Use this to send clicks to a specific product page instead of the brand's default landing page."
                },
                {
                  "disabled": false,
                  "key": "MediaPartnerPropertyId",
                  "value": "<string>",
                  "description": "Unique identifier of the media property (website, social profile, or app) where the link will be used. See the Partner Media Properties API."
                },
                {
                  "disabled": false,
                  "key": "subId1",
                  "value": "<string>",
                  "description": "Sub-affiliate identifier surfaced as a column in partner performance reports. Use to segment traffic by your own categories."
                },
                {
                  "disabled": false,
                  "key": "subId2",
                  "value": "<string>",
                  "description": "Additional sub-affiliate identifier surfaced as a column in partner performance reports."
                },
                {
                  "disabled": false,
                  "key": "subId3",
                  "value": "<string>",
                  "description": "Additional sub-affiliate identifier surfaced as a column in partner performance reports."
                },
                {
                  "disabled": false,
                  "key": "sharedId",
                  "value": "<string>",
                  "description": "Shared identifier surfaced as a column in partner performance reports."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "AccountSID",
                  "description": "(Required) Unique identifier for the partner account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ProgramId",
                  "description": "(Required) Unique identifier for the brand program the tracking link is for."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
